# Taliya landing runtime configuration
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets.

# Real AI for the web consultor.
# Requires an OpenAI Platform API key. A ChatGPT subscription is not enough.
OPENAI_API_KEY=
AI_ATTENDANT_MODEL=gpt-5.4-mini
AI_ATTENDANT_JSON_MODEL=gpt-5-mini

# Optional AI safety/cost controls.
# Set AI_ATTENDANT_DISABLED=true to force degraded/fallback behavior.
AI_ATTENDANT_DISABLED=false
AI_ATTENDANT_WEB_RATE_LIMIT_PER_MINUTE=12
AI_ATTENDANT_WHATSAPP_RATE_LIMIT_PER_MINUTE=8
AI_ATTENDANT_DAILY_REQUEST_CAP=300

# Internal operator panel.
# Use a long random value and open /internal/sales-inbox?token=<value>.
INTERNAL_SALES_INBOX_TOKEN=

# Production persistence for WhatsApp sessions, idempotency, outbox, usage logs,
# Sales Inbox leads/messages and operator audit. Without DATABASE_URL the app
# falls back to process-local memory for local demos only.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# n8n webhooks. Optional automations/alerts only.
# Lead storage is handled by DATABASE_URL/Sales Inbox.
# Best-effort: missing/failing webhooks must not block the site.
N8N_WEBHOOK_HIGH_INTENT=
N8N_WEBHOOK_OPERATOR_ACTION=
N8N_WEBHOOK_DIAGNOSTIC_HANDOFF=
N8N_WEBHOOK_LEAD_ALERT=
N8N_WEBHOOK_SAFETY_EVENT=
N8N_WEBHOOK_CUSTOM_AGENT_DIAGNOSTIC=
N8N_WEBHOOK_SECRET=

# Official Meta WhatsApp Cloud API.
# With Dualhook Developer/Webhook Override, Dualhook configures coexistence and routes
# Meta message webhooks directly here; sending still uses Meta Graph API from backend.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_GRAPH_VERSION=v20.0

# Optional fallback for providers that support a shared webhook secret.
# Dualhook Webhook Override message events come directly from Meta, so if
# META_WHATSAPP_APP_SECRET is unavailable the route validates payload shape
# and META_WHATSAPP_PHONE_NUMBER_ID instead.
DUALHOOK_WEBHOOK_SECRET=
